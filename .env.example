# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://skillpulse-ai.vercel.app

# Database Connection (Neon Serverless PostgreSQL with SSL & Pooler)
DATABASE_URL="postgresql://username:password@ep-your-pooler.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=20"

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# SMTP Email Dispatcher (Gmail or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="SkillPulse AI" <noreply@skillpulse-ai.com>

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# AI Model Inference Providers
AI_SERVICE_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LMS Integration
YOUTUBE_API_KEY=your_youtube_api_key_here
