generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  TEAM_LEADER
  EMPLOYEE
}

enum SubscriptionTier {
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  PENDING_PAYMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_INVITE
}

enum GapSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum EnrollmentStatus {
  NOT_STARTED
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum BenchReadiness {
  READY_NOW
  WITHIN_1_YEAR
  WITHIN_2_YEARS
  LONG_TERM
}

enum FlightRisk {
  LOW
  MEDIUM
  HIGH
}

enum ComplianceStatus {
  COMPLIANT
  PENDING
  EXPIRED
  NON_COMPLIANT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

// ----------------------------------------------------
// 1. MULTI-TENANCY & WORKSPACES
// ----------------------------------------------------

model Tenant {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  domain           String?          @unique
  plan             SubscriptionTier @default(PRO)
  status           TenantStatus     @default(ACTIVE)
  maxUsers         Int              @default(500)
  
  // Stripe Billing Integration
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  
  logoUrl          String?
  themeSettings    Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  users            User[]
  departments      Department[]
  teams            Team[]
  skills           Skill[]
  skillCategories  SkillCategory[]
  skillGaps        SkillGap[]
  courses          Course[]
  enrollments      LearningEnrollment[]
  projects         Project[]
  successionPools  SuccessionPool[]
  complianceItems  ComplianceRecord[]
  auditLogs        AuditLog[]
  integrations     IntegrationConfig[]
  systemParameters SystemParameter[]

  @@index([slug])
  @@index([status])
}

// ----------------------------------------------------
// 2. IDENTITY, AUTH & ORGANIZATIONAL HIERARCHY
// ----------------------------------------------------

model User {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  email            String             @unique
  passwordHash     String
  firstName        String
  lastName         String
  avatarUrl        String?
  role             Role               @default(EMPLOYEE)
  jobTitle         String?
  status           UserStatus         @default(ACTIVE)
  
  ssoProvider      String?            // e.g. "google", "microsoft", "workday"
  ssoId            String?
  
  resetToken       String?
  resetTokenExpiry DateTime?
  
  departmentId     String?
  department       Department?        @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  
  teamId           String?
  team             Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  // Reverse Relations
  ledDepartments   Department[]       @relation("DepartmentHead")
  ledTeams         Team[]             @relation("TeamLeader")
  
  skills           UserSkill[]
  skillGaps        SkillGap[]
  assessments      SkillAssessment[]
  enrollments      LearningEnrollment[]
  successionBenches SuccessionPool[]
  complianceRecords ComplianceRecord[]
  evaluationsGiven PerformanceRecord[] @relation("Evaluator")
  evaluationsReceived PerformanceRecord[] @relation("EvaluatedUser")
  managedProjects  Project[]          @relation("ProjectLead")
  auditLogs        AuditLog[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, role])
  @@index([departmentId])
  @@index([teamId])
}

model Department {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  code        String?
  description String?
  
  headId      String?
  head        User?     @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  teams       Team[]
  members     User[]    @relation("DepartmentMembers")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Team {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  name         String
  description  String?
  
  leaderId     String?
  leader       User?      @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  
  members      User[]     @relation("TeamMembers")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, departmentId])
}

// ----------------------------------------------------
// 3. SKILL TAXONOMY & PROFICIENCY
// ----------------------------------------------------

model SkillCategory {
  id          String   @id @default(uuid())
  tenantId    String?  // null = Global taxonomy seed
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  iconName    String?
  
  skills      Skill[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Skill {
  id               String         @id @default(uuid())
  tenantId         String?        // null = Global taxonomy seed
  tenant           Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  categoryId       String
  category         SkillCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  name             String
  description      String?
  isGlobal         Boolean        @default(false)
  proficiencyLevel String?        @default("Beginner")   // Beginner | Intermediate | Advanced | Expert
  priorityTier     String?        @default("Low")        // Low | Medium | High | Critical
  benchmarkScore   Int?           @default(75)           // Target Benchmark Score percentage (0-100)

  userSkills   UserSkill[]
  skillGaps    SkillGap[]
  courseSkills CourseSkill[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId])
  @@index([categoryId])
}

model UserSkill {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  skillId          String
  skill            Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  proficiencyLevel Float     @default(1.0) // 1.0 to 5.0
  verified         Boolean   @default(false)
  verifiedBy       String?
  yearsExperience  Float     @default(0.0)
  lastAssessedAt   DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ----------------------------------------------------
// 4. ASSESSMENTS & SKILL GAPS
// ----------------------------------------------------

model SkillAssessment {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title          String
  category       String
  score          Float     // e.g. 85%
  totalQuestions Int
  correctAnswers Int
  resultsJson    Json      // Details per question & inferred skills
  certificateUrl String?
  credentialId   String?
  
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model SkillGap {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  skillId            String
  skill              Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  requiredLevel      Float        // Target proficiency (e.g. 4.5)
  currentLevel       Float        // Current proficiency (e.g. 2.0)
  severity           GapSeverity  @default(MEDIUM) // CRITICAL, HIGH, MEDIUM, LOW
  
  assignedCourseId   String?
  assignedCourse     Course?      @relation(fields: [assignedCourseId], references: [id], onDelete: SetNull)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, skillId])
  @@index([tenantId, severity])
  @@index([userId])
}

// ----------------------------------------------------
// 5. LEARNING & COURSES
// ----------------------------------------------------

model Course {
  id               String               @id @default(uuid())
  tenantId         String?              // null = platform-wide catalog
  tenant           Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title            String
  description      String?
  provider         String               @default("Internal LMS") // Coursera, Udemy, Internal
  durationHours    Float                @default(10.0)
  level            String               @default("Intermediate") // Beginner, Intermediate, Advanced
  rating           Float                @default(4.8)
  thumbnailUrl     String?
  externalUrl      String?
  isCompliance     Boolean              @default(false)

  skillsTaught     CourseSkill[]
  enrollments      LearningEnrollment[]
  gapsAddressed    SkillGap[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId])
}

model CourseSkill {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  skillId           String
  skill             Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  targetProficiency Float    @default(3.0)

  @@unique([courseId, skillId])
}

model LearningEnrollment {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitle    String?
  
  status         EnrollmentStatus @default(ENROLLED)
  progressPct    Float            @default(0.0)
  
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  certificateUrl String?
  credentialId   String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([tenantId, status])
  @@index([userId])
}

// ----------------------------------------------------
// 6. PROJECTS & AI SQUAD FORMATION
// ----------------------------------------------------

model Project {
  id             String                     @id @default(uuid())
  tenantId       String
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title          String
  description    String?
  status         ProjectStatus              @default(PLANNING)
  
  leaderId       String?
  leader         User?                      @relation("ProjectLead", fields: [leaderId], references: [id], onDelete: SetNull)
  
  requiredSkills Json                       // Array of { skill: string, minLevel: number }
  teamSizeTarget Int                        @default(5)
  deadline       DateTime?

  aiSuggestions  ProjectRecommendation[]

  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([tenantId, status])
}

model ProjectRecommendation {
  id                  String   @id @default(uuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  recommendedSquad    Json     // Array of candidate user objects with match %
  overallMatchScore   Float    // e.g. 92.4%
  skillCoveragePct    Float    // e.g. 96.0%
  isApproved          Boolean  @default(false)
  
  createdAt           DateTime @default(now())

  @@index([projectId])
}

// ----------------------------------------------------
// 7. CAREER PATHS, SUCCESSION & COMPLIANCE
// ----------------------------------------------------

model SuccessionPool {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  targetRole      String
  department      String
  
  candidateId     String
  candidate       User           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  readiness       BenchReadiness @default(WITHIN_1_YEAR)
  flightRisk      FlightRisk     @default(LOW)
  leadershipScore Float          @default(80.0)
  notes           String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([candidateId])
}

model ComplianceRecord {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  regulationType String           // e.g. "ISO 27001", "GDPR", "OSHA Safety", "HIPAA"
  status         ComplianceStatus @default(PENDING)
  dueDate        DateTime
  completedDate  DateTime?
  certificateUrl String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([userId])
}

model PerformanceRecord {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation("EvaluatedUser", fields: [userId], references: [id], onDelete: Cascade)
  
  evaluatorId       String
  evaluator         User     @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  
  reviewPeriod      String   // e.g. "Q1 2026", "Annual 2025"
  performanceRating Float    // 1.0 to 5.0
  skillGrowthRating Float    // 1.0 to 5.0
  feedback          String?
  kpiMetricsJson    Json?

  createdAt         DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------
// 8. GOVERNANCE, INTEGRATIONS & AUDIT LOGS
// ----------------------------------------------------

model AIModelConfig {
  id            String   @id @default(uuid())
  modelName     String   @unique // e.g. "SkillPulse-Core-LLM-v2", "gpt-4o", "claude-3-5-sonnet"
  provider      String   @default("OpenAI / Azure")
  version       String   @default("2.4.0")
  temperature   Float    @default(0.2)
  maxTokens     Int      @default(2048)
  topP          Float    @default(0.9)
  contextWindow Int      @default(128000)
  isActive      Boolean  @default(true)
  hyperparams   Json?
  
  updatedAt     DateTime @updatedAt
}

model IntegrationConfig {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  type        String   // "HRIS_WORKDAY", "LMS_COURSERA", "PAYMENT_STRIPE", "SSO_SAML", "API_GATEWAY"
  name        String
  endpointUrl String?
  credentials Json?    // Secure encrypted API tokens
  status      String   @default("ACTIVE") // "ACTIVE", "DISCONNECTED"
  isEnabled   Boolean  @default(true)
  configJson  Json?
  lastSyncAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   // e.g. "USER_LOGIN", "ROLE_UPDATED", "SKILL_GAP_INFERRED", "TRAINING_ASSIGNED"
  resource    String   // e.g. "User", "SkillGap", "Team"
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
}

model SystemParameter {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  key         String
  value       String
  description String?
  isGlobal    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}
